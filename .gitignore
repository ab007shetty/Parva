# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — never commit secrets.
# Configuration lives in a single .env, which holds APPWRITE_API_KEY. Keep a
# copy somewhere safe: a fresh clone will not have it, and the file documents
# every variable it needs.
.env
.env.*

# typescript
*.tsbuildinfo

# vercel
.vercel

# copied at postinstall from node_modules/pdfjs-dist
/public/pdfjs/

# editors
.idea/
.vscode/*
!.vscode/extensions.json

# testing
/coverage
/playwright-report/
/test-results/
